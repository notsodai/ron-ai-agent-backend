# 开发环境配置示例
# 复制此文件为 application-dev.yml 并填入实际的配置值

spring:
  application:
    name: ron-ai-agent
  ai:
    dashscope:
      api-key: your-dashscope-api-key-here

  datasource:
    url: jdbc:postgresql://your-database-host/database_name
    username: your-username
    password: your-password

  search-api:
    api-key: your-search-api-key-here

# 开发环境配置
app:
  admin:
    token: dev-token-123
  cors:
    allowed-origins: "*"  # 开发环境允许所有源

logging:
  level:
    com.ron.ronaiagent: DEBUG
    org.springframework.web: DEBUG
